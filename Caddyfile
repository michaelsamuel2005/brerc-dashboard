# LEGACY LOCAL PLACEHOLDER ONLY — NOT A PRODUCTION REVERSE PROXY.
#
# This file does not serve the React build, routes to the obsolete Martin demo,
# and has no reviewed production TLS/security configuration. Keep it only for
# the historical root docker-compose.yml demo. The reviewed production nginx
# examples and validation procedure are under deploy/production/.
#
# Reverse proxy — serves the historical demo from ONE origin (B9).
# Everything is reached through http://localhost:8080, so the browser sees a
# single site (no cross-origin problems) — the "same-origin behind a reverse
# proxy" shape from the architecture decision. This does not constitute the
# reviewed production deployment.

:80 {
	# The read-only API, e.g.  /api/health , /api/species
	handle /api/* {
		reverse_proxy api:8000
	}

	# Vector tiles from Martin, e.g.  /tiles/catalog , /tiles/cells_tile/8/126/85
	# handle_path strips the /tiles prefix before forwarding to Martin.
	handle_path /tiles/* {
		reverse_proxy martin:3000
	}

	# The built front-end (React) would be served here in a full deploy.
	handle {
		respond "BRERC dashboard stack is running. Try /api/health or /tiles/catalog" 200
	}
}

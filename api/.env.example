# ---------------------------------------------------------------------------
# Example environment file.
#   - `.env` is git-ignored (never commit it — it holds your real password).
#   - This `.env.example` has NO secrets, so it is safe to commit and share.
# The API reads these at startup (see api/app/db.py).
#
# NOTE ON PRECEDENCE: for every *_URL variable below, config/safety.yaml is
# the normal way to configure that connection (explicit host/database/user/
# password fields) — these environment variables are fallbacks
# for deployments (such as Docker/CI) that do not mount a safety.yaml file.
# If safety.yaml already has real credentials for a connection, the matching
# variable here is simply unused — you don't need to fill in both.
# ---------------------------------------------------------------------------

# PostgreSQL connection for the public API (api/app/db.py). Used when
# config/safety.yaml's 'api_readonly' block is unset — deliberately a
# separate block from 'destination' below, which holds the ETL's
# write-capable credentials. This connection must always use a role with
# read-only grants. The app verifies live membership in the dedicated
# `brerc_api` group role, rejects loader/Martin/monitor/write-all memberships,
# and forces every session transaction-read-only before running a public query.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For local development this points at your own machine's Postgres.
# In production, BRERC swaps this for their database + a READ-ONLY role
# (dev -> prod is a credentials change only — decision D-005).
#
# IMPORTANT: this role MUST be read-only. api/app/db.py's whole security
# model assumes it can never write, as a safety net in case of a bug in the
# API layer. Never reuse this same role/URL for the ETL below — see
# DESTINATION_DATABASE_URL for why they're kept deliberately separate.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/brerc_ui
# Production must also verify the database certificate and hostname. Mount the
# BRERC/Council CA certificate read-only, set APP_ENV=prod, and use this shape:
# DATABASE_URL=postgresql://brerc_api_login:CHANGE_ME@db.example.org:5432/brerc_public?sslmode=verify-full&sslrootcert=/run/secrets/brerc-db-ca.pem

# ---------------------------------------------------------------------------
# ETL-only connections (api/etl/job.py, api/etl/db.py, api/etl/load/reload.py).
# These are SEPARATE from DATABASE_URL above on purpose — the API's role must
# stay read-only, and the ETL needs write (and, briefly, DDL) access. Sharing
# one variable between the two would either break the ETL against a
# read-only role, or tempt someone into widening DATABASE_URL's permissions
# to fix that — which would silently give the public API write access too.
# ---------------------------------------------------------------------------

# Only needed when source.mode is "database" in config/safety.yaml (not for
# "csv" mode). Read-only connection to BRERC's own source database.
# Used when safety.yaml's 'connection' block is unset.
# SOURCE_DATABASE_URL=postgresql://brerc_source_ro:CHANGE_ME@source-host:5432/brerc_source

# The ETL's everyday write connection — the destination/UI database, via a
# role that can INSERT/UPDATE/DELETE but should NOT have schema-level (DDL)
# privileges like DROP/CREATE. Used when config/safety.yaml's 'destination'
# block is unset; never falls back to DATABASE_URL.
DESTINATION_DATABASE_URL=postgresql://etl_write:CHANGE_ME@localhost:5432/brerc_ui

# A separate, more privileged role used ONLY for full schema resets
# (dropping and recreating tables when the destination is missing or empty —
# see api/etl/load/reload.py). MUST point at the exact same database as
# DESTINATION_DATABASE_URL/safety.yaml's 'destination' block (same
# host/port/dbname — the role/password can and should differ). Used when
# safety.yaml's 'admin' block is unset. If neither is configured, the app
# now refuses to run a reset rather than guess, but it's still on you to set
# one of them correctly for resets to actually work.
DATABASE_URL_ADMIN=postgresql://etl_admin:CHANGE_ME@localhost:5432/brerc_ui

# Environment: "dev" (default) or "prod".
#   prod  -> /docs is disabled and CORS is locked to ALLOWED_ORIGINS only.
APP_ENV=dev

# Production only: comma-separated website(s) allowed to call the API from a
# browser (the BRERC/council domain the dashboard is embedded in). Ignored in dev.
# ALLOWED_ORIGINS=https://www.brerc.org.uk

# Max milliseconds a single SQL query may run before PostgreSQL cancels it.
DB_STATEMENT_TIMEOUT_MS=5000

# Optional — where data files (e.g. the sensitive-species list) are read from.
# Defaults to the repo's git-ignored `data/` folder. Real client data lives
# here and is NEVER committed.
# DATA_DIR=../data


# ---------------------------------------------------------------------------
# Species images + descriptions (B8). See api/app/species_info.py.
# Only the species' scientific name is ever sent to these third parties —
# never records, locations or recorder names.
# ---------------------------------------------------------------------------

# Off by default. Set to true to start fetching species photos + descriptions.
SPECIES_INFO_ENABLED=false

# REQUIRED when enabled: an email address or project url. iNaturalist, GBIF and
# Wikipedia all ask API clients to identify themselves, and the proxy refuses to
# run without this. Use a team/BRERC address, not a personal one.
# SPECIES_INFO_CONTACT=dashboard@brerc.org.uk

# Image licences we are allowed to display. The default (CC0 / public domain /
# CC BY) is the safe choice for a public site that may become commercial.
# Anything not on this list — including CC BY-NC and CC BY-SA — is refused, and
# a photo with no stated licence is always refused. Add cc-by-sa only if BRERC
# confirms share-alike images are acceptable.
# SPECIES_IMAGE_ALLOWED_LICENCES=cc0,pd,cc-by

# Where the answer cache is kept, so we never re-call a third party on every
# page view. Defaults to api/.cache/species_info.sqlite3 (git-ignored).
# SPECIES_INFO_CACHE_PATH=/app/.cache/species_info.sqlite3

# Tuning — the defaults are sensible; change only if you have a reason.
# SPECIES_INFO_TIMEOUT_SECONDS=4
# SPECIES_INFO_CACHE_TTL_DAYS=30
# SPECIES_INFO_MISS_TTL_MINUTES=360
# SPECIES_INFO_MIN_INTERVAL_SECONDS=0.25
# SPECIES_INFO_DESCRIPTION_MAX_CHARS=600

{
  "name": "brerc-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.a11y.json --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "guard": "node scripts/guard-forbidden.mjs",
    "guard:bundle": "node scripts/guard-bundle.mjs",
    "e2e": "playwright test --config playwright.config.ts",
    "e2e:serialization": "playwright test --config playwright.serialization.config.ts",
    "e2e:all": "npm run e2e:serialization && npm run e2e",
    "e2e:install": "playwright install --with-deps chromium firefox webkit",
    "a11y:mutate": "python3 mutation/run_disposable.py --output-dir test-results/a11y-mutation --verify-kills"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.59.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-aria-components": "^1.4.1",
    "react-dom": "^18.3.1",
    "react-map-gl": "^7.1.7",
    "recharts": "^3.10.1",
    "wouter": "3.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.48.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "msw": "^2.4.9",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}

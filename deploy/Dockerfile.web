# The public front end, built and then served by the same Caddy that proxies
# the API — so the browser sees one origin (decision D-001).
#
# VITE_API_BASE_URL is deliberately NOT set: the app defaults to the relative
# "/api", which is what makes the deployment same-origin. Setting an absolute
# URL here would reintroduce cross-origin requests and the CORS configuration
# that goes with them.
FROM node:22-slim AS build
WORKDIR /src
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web ./
COPY contracts /contracts
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /src/dist /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile

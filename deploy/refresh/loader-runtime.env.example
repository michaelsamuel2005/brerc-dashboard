# NON-RUNNABLE, CREDENTIAL-FREE TEMPLATE.
# The real file belongs at /etc/brerc/refresh/loader-runtime.env, outside Git.
# Values ending in _SECRET are intentionally empty so this example fails closed.

# One protected libpq service file contains separately named, approved source
# and target profiles. The loader pins TLS verify-full independently of the
# profile and uses the distinct passfiles and CA files below.
PGSERVICEFILE=/etc/brerc/refresh/pg_service.conf
BRERC_SOURCE_SERVICE=REPLACE_WITH_APPROVED_SOURCE_SERVICE
BRERC_SOURCE_PASSFILE=/etc/brerc/refresh/source.pgpass
BRERC_SOURCE_SSLROOTCERT=/etc/brerc/refresh/source-ca.pem
BRERC_TARGET_SERVICE=REPLACE_WITH_APPROVED_TARGET_SERVICE
BRERC_TARGET_PASSFILE=/etc/brerc/refresh/target.pgpass
BRERC_TARGET_SSLROOTCERT=/etc/brerc/refresh/target-ca.pem

# Supply independent values of at least 32 UTF-8 bytes through the approved
# production secret-store export. Never put them in Git, a ticket or a command.
BRERC_PUBLIC_ID_SECRET=
BRERC_RECONCILIATION_SECRET=

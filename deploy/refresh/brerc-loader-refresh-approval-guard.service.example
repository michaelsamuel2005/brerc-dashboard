# EXAMPLE ONLY. Install only with the reviewed refresh service and timer.
# This root-owned guard disarms the schedule whenever userspace is shut down,
# soft-rebooted or suspended; /run itself can survive a systemd soft reboot.

[Unit]
Description=Disarm BRERC refresh approval across lifecycle transitions
Before=brerc-loader-refresh.timer sleep.target systemd-soft-reboot.service shutdown.target
Conflicts=sleep.target systemd-soft-reboot.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/test -d /run/brerc/refresh
ExecStop=/usr/bin/rm -f -- /run/brerc/refresh/APPROVED_TO_SCHEDULE
RemainAfterExit=yes
Restart=no
StandardOutput=journal
StandardError=journal
SyslogIdentifier=brerc-loader-refresh-approval-guard

# The guard needs root access only to inspect one runtime directory and unlink
# one exact marker during stop. It cannot use the network or write elsewhere.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=-/run/brerc/refresh
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
RemoveIPC=true
LimitCORE=0

# EXAMPLE ONLY. Render and validate this file before installing it. This public
# virtual host serves only the immutable React build and same-origin /api.

server {
    listen 80;
    listen [::]:80;
    server_name REPLACE_WITH_PUBLIC_DASHBOARD_HOSTNAME;
    server_tokens off;
    return 301 https://REPLACE_WITH_PUBLIC_DASHBOARD_HOSTNAME$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name REPLACE_WITH_PUBLIC_DASHBOARD_HOSTNAME;
    server_tokens off;

    ssl_certificate /etc/brerc/tls/public/fullchain.pem;
    ssl_certificate_key /etc/brerc/tls/public/privkey.pem;

    root /opt/brerc-dashboard/releases/REPLACE_WITH_APPROVED_ARTIFACT_ID/web/dist;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: REPLACE_WITH_APPROVED_BASEMAP_ORIGIN; connect-src 'self' REPLACE_WITH_APPROVED_BASEMAP_ORIGIN; worker-src 'self' blob:; manifest-src 'self'" always;

    # These surfaces are deliberately absent from the public architecture.
    location = /tiles { return 404; }
    location ^~ /tiles/ { return 404; }
    location = /run-dashboard { return 404; }
    location ^~ /run-dashboard/ { return 404; }

    location = /api {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $server_name;
        proxy_set_header X-Forwarded-Host $server_name;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_hide_header Server;
        add_header Cache-Control "no-store, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: REPLACE_WITH_APPROVED_BASEMAP_ORIGIN; connect-src 'self' REPLACE_WITH_APPROVED_BASEMAP_ORIGIN; worker-src 'self' blob:; manifest-src 'self'" always;
    }

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $server_name;
        proxy_set_header X-Forwarded-Host $server_name;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_hide_header Server;
        add_header Cache-Control "no-store, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: REPLACE_WITH_APPROVED_BASEMAP_ORIGIN; connect-src 'self' REPLACE_WITH_APPROVED_BASEMAP_ORIGIN; worker-src 'self' blob:; manifest-src 'self'" always;
    }

    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: REPLACE_WITH_APPROVED_BASEMAP_ORIGIN; connect-src 'self' REPLACE_WITH_APPROVED_BASEMAP_ORIGIN; worker-src 'self' blob:; manifest-src 'self'" always;
    }

    # MapLibre's pinned worker is deliberately emitted with a .cjs suffix, which
    # MapLibre interprets as a request for a classic worker. Stock nginx does not
    # assign .cjs a JavaScript MIME type; with nosniff enabled that would make the
    # production browser reject it even though Vite's local server accepts it.
    location = /maplibre-gl-worker.cjs {
        try_files $uri =404;
        default_type application/javascript;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: REPLACE_WITH_APPROVED_BASEMAP_ORIGIN; connect-src 'self' REPLACE_WITH_APPROVED_BASEMAP_ORIGIN; worker-src 'self' blob:; manifest-src 'self'" always;
    }

    # React owns client-side routes; index.html must not be cached across an
    # atomic application release change.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: REPLACE_WITH_APPROVED_BASEMAP_ORIGIN; connect-src 'self' REPLACE_WITH_APPROVED_BASEMAP_ORIGIN; worker-src 'self' blob:; manifest-src 'self'" always;
    }
}

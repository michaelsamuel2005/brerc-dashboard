# EXAMPLE ONLY: credential-free settings for the isolated public API process.
# Copy to /etc/brerc/production/api/public-api.env only after replacing every
# REPLACE_WITH_* value. The database password belongs only in the protected
# passfile named below; never add it to this file or to Git.

# APP_ENV is fixed to prod by brerc-public-api.service. Do not repeat it here:
# systemd EnvironmentFile values override Environment= values.
ALLOWED_ORIGINS=https://REPLACE_WITH_PUBLIC_DASHBOARD_HOSTNAME
BRERC_API_DB_MODE=service
BRERC_API_DB_SERVICE=REPLACE_WITH_API_LIBPQ_SERVICE
PGSERVICEFILE=/etc/brerc/production/api/pg_service.conf
BRERC_API_DB_PASSFILE=/etc/brerc/production/api/api.pgpass
BRERC_API_DB_SSLROOTCERT=/etc/brerc/production/api/postgres-ca.pem
BRERC_API_EXPECTED_DATABASE=REPLACE_WITH_PUBLICATION_DATABASE_NAME
BRERC_API_EXPECTED_ROLE=REPLACE_WITH_API_LOGIN_ROLE
DB_STATEMENT_TIMEOUT_MS=5000
MAX_PAGE_SIZE=100
MAX_CELLS=5000
MAX_GROUPS=50

# Third-party media is disabled until its licences, hosts and privacy effects
# have been approved. Enabling it is a separate production change.
SPECIES_INFO_ENABLED=false

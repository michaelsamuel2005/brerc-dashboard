# EXAMPLE ONLY: non-secret settings for the private ETL run-history dashboard.
# Authentication values are supplied only through the separately managed,
# root-owned run-dashboard.secrets.env. The database password lives only in the
# protected passfile named below; neither file is tracked in Git.

# DASHBOARD_ENV is fixed to prod by brerc-run-dashboard.service. Do not repeat
# it here: systemd EnvironmentFile values override Environment= values.
RUN_DASHBOARD_DB_MODE=service
RUN_DASHBOARD_DB_SERVICE=REPLACE_WITH_MONITOR_LIBPQ_SERVICE
PGSERVICEFILE=/etc/brerc/production/monitor/pg_service.conf
RUN_DASHBOARD_DB_PASSFILE=/etc/brerc/production/monitor/monitor.pgpass
RUN_DASHBOARD_DB_SSLROOTCERT=/etc/brerc/production/monitor/postgres-ca.pem
RUN_DASHBOARD_EXPECTED_DATABASE=REPLACE_WITH_PUBLICATION_DATABASE_NAME
RUN_DASHBOARD_EXPECTED_ROLE=REPLACE_WITH_MONITOR_LOGIN_ROLE

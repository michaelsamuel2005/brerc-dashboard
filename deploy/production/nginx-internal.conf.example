# EXAMPLE ONLY. This is a separate internal hostname on an approved private
# interface. The CIDR allow-list, firewall and dashboard login are independent
# controls; none may be omitted. Never include this server block in the public
# dashboard virtual host.

server {
    listen REPLACE_WITH_APPROVED_PRIVATE_IP:443 ssl http2;
    server_name REPLACE_WITH_PRIVATE_RUN_DASHBOARD_HOSTNAME;
    server_tokens off;

    ssl_certificate /etc/brerc/tls/internal/fullchain.pem;
    ssl_certificate_key /etc/brerc/tls/internal/privkey.pem;

    allow REPLACE_WITH_APPROVED_OPERATOR_CIDR;
    deny all;

    client_max_body_size 32k;
    add_header Cache-Control "no-store, max-age=0" always;
    add_header Pragma "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;

    location / {
        proxy_pass http://127.0.0.1:8100;
        proxy_http_version 1.1;
        proxy_set_header Host $server_name;
        proxy_set_header X-Forwarded-Host $server_name;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_hide_header Server;
        proxy_buffering off;
    }
}

# EXAMPLE ONLY. This file is deliberately not an installable systemd unit.
# An authorised operator must approve the first production load and its inputs
# before copying it to /etc/systemd/system/brerc-loader-initial.service.
# There is no timer. ExecStartPre consumes APPROVED_TO_INITIAL exactly once.

[Unit]
Description=BRERC first atomic publication load
Wants=network-online.target
After=network-online.target
OnFailure=brerc-loader-initial-quarantine.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=brerc-loader
Group=brerc-loader
UMask=0077
WorkingDirectory=/opt/brerc-dashboard/releases/REPLACE_WITH_APPROVED_ARTIFACT_ID
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/brerc/refresh/loader-runtime.env
UnsetEnvironment=PGPASSWORD
ExecStartPre=/usr/bin/test -x /opt/brerc-dashboard/releases/REPLACE_WITH_APPROVED_ARTIFACT_ID/bin/brerc-load
ExecStartPre=/usr/bin/test -s /etc/brerc/refresh/loader.configuration.yaml
ExecStartPre=/usr/bin/test -s /etc/brerc/refresh/source.configuration.yaml
ExecStartPre=/usr/bin/test -s /etc/brerc/refresh/publication-policy.approved.json
ExecStartPre=/usr/bin/test -s /etc/brerc/refresh/species-dictionary.approved.csv
ExecStartPre=/usr/bin/test -s /etc/brerc/refresh/loader-runtime.env
ExecStartPre=/usr/bin/test -s /etc/brerc/refresh/pg_service.conf
ExecStartPre=/usr/bin/test -s /etc/brerc/refresh/source.pgpass
ExecStartPre=/usr/bin/test -s /etc/brerc/refresh/target.pgpass
ExecStartPre=/usr/bin/test -s /etc/brerc/refresh/source-ca.pem
ExecStartPre=/usr/bin/test -s /etc/brerc/refresh/target-ca.pem
ExecStartPre=!/usr/bin/env -i /usr/bin/python3 -I /usr/local/libexec/brerc/consume-initial-approval.py --expected-artifact-id REPLACE_WITH_APPROVED_ARTIFACT_ID
ExecStart=/opt/brerc-dashboard/releases/REPLACE_WITH_APPROVED_ARTIFACT_ID/bin/brerc-load initial --config /etc/brerc/refresh/loader.configuration.yaml
TimeoutStartSec=2h15m
TimeoutStopSec=30s
KillMode=mixed
Restart=no
StandardOutput=journal
StandardError=journal
SyslogIdentifier=brerc-loader-initial

# The loader needs only filesystem reads, private temporary storage and TCP or
# Unix-socket database connections. It is not permitted to gain privileges or
# alter the host, deployed code, configuration, credentials or kernel state.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/brerc/refresh /opt/brerc-dashboard/releases/REPLACE_WITH_APPROVED_ARTIFACT_ID
ReadWritePaths=/etc/brerc/initial-approval
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RemoveIPC=true
LimitCORE=0

# ---------------------------------------------------------------------------
# Example environment file. COPY this to `.env` and fill in your own values.
#   - `.env` is git-ignored (never commit it — it holds your real password).
#   - This `.env.example` has NO secrets, so it is safe to commit and share.
# app.py reads these at startup.
# ---------------------------------------------------------------------------

# Shared login for the run-history dashboard. Anyone with these credentials
# can view the ETL run history. REQUIRED — there is no default login; the
# app refuses to start if either is missing.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME

# Key used to sign the session cookie. Set this to a long random string in
# any environment where you want logins to survive a server restart —
# otherwise a new key is generated each time the app starts, which logs
# everyone out. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET_KEY=

# Environment: "dev" (default) or "prod".
#   prod -> the session cookie is marked https_only, so it will only ever be
#   sent over HTTPS. Leave as dev for local http:// testing.
DASHBOARD_ENV=dev

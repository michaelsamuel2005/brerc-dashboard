# ---------------------------------------------------------------------------
# Example environment file. COPY this to `.env` and fill in your own values.
#   - `.env` is git-ignored (never commit it — it holds your real password).
#   - This `.env.example` has NO secrets, so it is safe to commit and share.
# app.py reads these at startup.
# ---------------------------------------------------------------------------

# Shared login for the run-history dashboard. Anyone with these credentials
# can view the ETL run history. REQUIRED — there is no default login; the
# app refuses to start if either is missing.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME

# Key used to sign the session cookie. Production requires a persistent value
# of at least 32 characters; local dev/test may leave it blank and receive a
# per-process key that logs everyone out on restart. Generate one outside shell
# history with the approved secret manager, or for local testing with:
# python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET_KEY=

# Environment: exactly "dev", "test" or "prod". There is no default; a missing
# or misspelled value stops startup.
#   prod -> the session cookie is marked https_only, so it will only ever be
#   sent over HTTPS. Leave as dev for local http:// testing.
DASHBOARD_ENV=dev

# Authoritative PostgreSQL monitoring connection. Production must use service
# mode so no DSN or password is stored here. The passfile is supplied separately
# by the deployment secret store and must be readable only by the service.
RUN_DASHBOARD_DB_MODE=service
RUN_DASHBOARD_DB_SERVICE=brerc-monitor
PGSERVICEFILE=/etc/brerc/pg_service.conf
RUN_DASHBOARD_DB_PASSFILE=/run/secrets/brerc-monitor.pgpass
RUN_DASHBOARD_DB_SSLROOTCERT=/etc/brerc/postgres-ca.crt
RUN_DASHBOARD_EXPECTED_DATABASE=REPLACE_WITH_UI_DATABASE_NAME
RUN_DASHBOARD_EXPECTED_ROLE=REPLACE_WITH_MONITOR_LOGIN_ROLE

# Local/test alternative only. Set RUN_DASHBOARD_DB_MODE=direct and provide a
# disposable DSN. Direct mode is rejected whenever DASHBOARD_ENV=prod.
RUN_DASHBOARD_DATABASE_URL=

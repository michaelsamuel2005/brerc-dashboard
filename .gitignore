# The credential-free configuration.example.yaml may be reviewed and versioned.
/api/configuration.yaml
.pgpass
pgpass.conf
.pg_service.conf
pg_service.conf
*.pgpass
*.pg_service.conf
*.key
brerc-source.pgpass
brerc-source.pg_service.conf
brerc-source-client.key
brerc-source-client.crt


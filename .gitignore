# The credential-free example is the documentation of which variables the
# run-history dashboard needs; it holds placeholders only and is safe to track.
!run-dashboard/.env.example

# Local runtime state — the ETL run-history SQLite log written by
# api/etl/run_history.py and read by run-dashboard/. Run metadata only (no
# record content), but runtime state never belongs in git.
logs/

# Trusted PostgreSQL source connector — deployment configuration, credential
# lookup files and private client keys live in BRERC's secret store, never git.
# The credential-free configuration.example.yaml and public root CA certificate
# may be reviewed and versioned separately; these exact deployment names may not.
/api/configuration.yaml
/api/loader.configuration.yaml
publication-policy*.json
publication_policy*.json
.pgpass
pgpass.conf
.pg_service.conf
pg_service.conf
*.pgpass
*.pg_service.conf
*.key
brerc-source.pgpass
brerc-source.pg_service.conf
brerc-source-client.key
brerc-source-client.crt


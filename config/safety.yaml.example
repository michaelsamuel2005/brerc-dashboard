# =============================================================================
# BRERC ETL — safety.yaml
# =============================================================================
# Where the databases are, which source column plays each role, and the
# publication rules. Copy to config/safety.yaml and fill in.
#
# Do NOT put real credentials in this file. Leave user/password empty to use
# the environment fallbacks instead (SOURCE_DATABASE_URL,
# DESTINATION_DATABASE_URL, DATABASE_URL_ADMIN, DATABASE_URL — see api/.env).
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE CONNECTIONS
# -----------------------------------------------------------------------------
# Each connection uses its own role; they are deliberately never shared.
# When configuring one here, set dbhostname, dbname, user and password together.

# BRERC's source database. Read-only: the ETL only ever SELECTs from it.
connection:
  dbhostname:
  port:
  dbname:
  user:
  password:

# The dashboard's database — the ETL's everyday write connection.
destination:
  dbhostname:
  port:
  dbname:
  user:
  password:
  schema: public
  table: occurrence_public

# Same database as 'destination', more privileged role. Used only for
# schema-mutating operations such as full rebuilds (api/etl/load/reload.py).
admin:
  dbhostname: localhost
  port: 5432
  dbname: brerc_ui
  user: ""
  password: ""

# The public API's read-only connection (api/app/db.py). The ETL never reads it.
#
# OPTIONAL — most setups leave this commented out. The API normally takes its
# connection from DATABASE_URL in api/.env, and always does under Docker (the
# API image copies only app/, so this file is not there). If you uncomment it,
# set BOTH user and password, or neither: a half-filled block raises "The
# api_readonly block is incomplete" rather than falling back to DATABASE_URL.
#
# Kept separate from 'destination' on purpose: the API must connect with a
# read-only role (brerc_api_ro), never the ETL's write credentials.

# api_readonly:
#   dbhostname:
#   port:
#   dbname:
#   user:
#   password:


# -----------------------------------------------------------------------------
# SOURCE
# -----------------------------------------------------------------------------
source:
  mode: "database"          # or "csv"

  # database mode. These are the mock BRERC database's views; BRERC: replace
  # with your real view/table names.
  records_query: "SELECT * FROM brerc_source.vw_occurrences"
  dictionary_query: "SELECT * FROM brerc_source.vw_species_dictionary"

  # csv mode only. The file's columns must match 'columns:' below just as the
  # database view's do.
  records_path: "../data/records.csv"
  dictionary_path: "../data/full_dictionary.csv"


# -----------------------------------------------------------------------------
# COLUMNS — the ONLY place BRERC's column names appear
# -----------------------------------------------------------------------------
# Left: the pipeline's name for the column (fixed, used by the code).
# Right: what BRERC calls it. If BRERC renames a column, change the RIGHT side.
#
# Straight after the data is read, these columns are renamed to the left-hand
# names and EVERY OTHER COLUMN IS DROPPED. Place, comments, grid_ref, recorder
# details and so on never enter the pipeline, so they cannot be published.
#
# The ETL checks every mapping when it starts: a right-hand column missing
# from BRERC's data stops the run with a message naming the line to fix.
# Right-hand names are matched after cleaning (lowercased, spaces as "_").

# Occurrence records (source.records_query / source.records_path).
# Required: unique_no, scientific_name, common_name, species_no, record_type,
#           verified, easting, northing, date_of_record, modified_date.
# Optional: source_year, sensitive, abundance, sex_stage, vitality. Leave one
#           out (or set it to null) if the source does not have it. Leaving
#           out `sensitive` means "this source has no sensitivity flag".
columns:
  unique_no: unique_no
  scientific_name: scientific_name
  common_name: common_name
  species_no: species_no
  record_type: record_type
  verified: verified
  easting: easting                # PRECISE — generalised, never published
  northing: northing              # PRECISE — generalised, never published
  date_of_record: date_of_record  # free text: "14/05/2024", "June 2023"
  modified_date: date_mdb_modified  # drives incremental loading
  source_year: year_end           # the year when date_of_record is vague
                                  # ("February 2007"); end year for ranges
  sensitive: sensitive            # 'Yes' is blurred to 1 km, per BRERC
  abundance: abundance            # hashed, never published
  sex_stage: sex_stage            # hashed, never published
  vitality: vitality              # hashed, never published

# Species dictionary (source.dictionary_query / source.dictionary_path).
# All required.
dictionary_columns:
  scientific_name: scientific
  species_no: species_no
  nbn_number: nbn_number
  common_name: common_nam
  taxon_group: taxanb             # shown as the species group on the dashboard

# BRERC's sensitive-species list (files.sensitive_species). All required.
sensitive_species_columns:
  species_no: species_no
  nbn_number: nbn_number


# -----------------------------------------------------------------------------
# FILES
# -----------------------------------------------------------------------------
files:
  sensitive_species:
    # BRERC's list of sensitive taxa. The job refuses to run without it.
    path: "data/sensitive_species.csv"


# -----------------------------------------------------------------------------
# LOADING
# -----------------------------------------------------------------------------
load:
  # true: after the first load, only records whose modified_date is on or
  # after the last load are reconciled.
  incremental_check: true

reconciliation:
  # Pipeline names (left-hand side of 'columns:'), not BRERC's. A change to
  # any of these is recorded in the stored content hash.
  hash_columns:
    - scientific_name
    - abundance
    - sex_stage
    - record_type
    - vitality
    - verified
    - easting
    - northing
  chunk_size: 5000


# -----------------------------------------------------------------------------
# PUBLICATION RULES
# -----------------------------------------------------------------------------
generalisation:
  d0_floor_m: 100                       # nothing is ever published finer than this
  default_sensitive_resolution_m: 1000  # BRERC: sensitive records "reduced to 1km squares"

aggregation:
  suppression_threshold: 2
  cell_size_m: 1000

species_resolutions: {}

verified_values:
  # BRERC write an EN DASH ("Accepted – correct"); dashes are normalised, so
  # either spelling matches.
  accepted:
    - "Accepted - correct"
    - "Accepted - considered correct"
    - "Accepted"          # older records written before the NBN terms
  legacy:
    - "BRERC"

flagged_record_types:
  - trapped at actinic light
  - trapped at light
  - trapped at mercury vapour light
  - night roost
  - tagged night roost
  - plant count
  - maternity roost
  - flower count
  - photographed
  - summer roost
  - hibernation
  - daylight site visit
  - day roost
  - rosette count
  # for bat roost and plant
  - field record
  - field record (bat roost sensitive record)
  - field record (plant sensitive record)
  - bat detector
  - box survey
  - hibernation roost
  - earth
  - droppings
  - handled
  - burrow
  - pre-parturition roost
  - netted
  - breeding
  - roost
  - emergence count
  - tagged day roost
  - grounded
  - possibly breeding
  - nest
  - holt
  - bedding
  - bat roost
  - lie-up
  - DNA or eDNA testing
  - AI or programme analysis
  - Beaver Lodge
  - Acoustic audio recording
  - Acoustic audio record
  - found dead
  - dam
  - gnawed timber

# Safety Gate Configuration

files:
  sensitive_species:
    path: "data/sensitive_species.csv"

# Source connection. When using YAML credentials, set dbhostname, dbname,
# user and password together; leave user/password empty to use the matching
# environment fallback instead.

connection:
  dbhostname:
  port:
  server:
  dbname:
  user:
  password:
  schema:
  table:

# Destination database — the ETL's write-capable connection. Set dbhostname,
# dbname, user and password together when configuring credentials here.

destination:
  dbhostname:
  port:
  server:
  dbname:
  user:
  password:
  schema: public
  table: occurrence_public

# Public API's read-only connection (api/app/db.py). Deliberately its own
# block, separate from 'destination' above: the API must connect with a
# login inheriting only the reviewed `brerc_api` group role, never the ETL's
# write credentials.
# Sharing 'destination' here would mean the "read-only" API silently starts
# writing on any host where safety.yaml wins over DATABASE_URL.
# Production requires PostgreSQL certificate and hostname verification. Point
# sslrootcert at the mounted BRERC/Council database CA certificate; never put a
# private key or a password in this example file.

api_readonly:
  dbhostname:
  port:
  dbname:
  user:
  password:
  sslmode: verify-full
  sslrootcert:

# Admin database connection. Set dbhostname, dbname, user and password together.
# Used only for schema-mutating operations such as full rebuilds.
# Do NOT put real credentials in this file.

admin:
  dbhostname: localhost
  port: 5432
  dbname: brerc_ui
  user: ""
  password: ""

load:
  # Safe default for the superseded occurrence_public ETL. The current dashboard
  # is updated with `brerc-load refresh`, which rebuilds one complete inactive
  # release and switches it atomically; do not enable this legacy watermark path.
  incremental_check: false

source:
  mode: "csv"

  # For "csv" mode
  records_path: "../data/varied_sample.csv"
  dictionary_path: "../data/full_dictionary.csv"

  # For "database" mode - BRERC: replace with your real table/view names
  records_query: "SELECT * FROM your_source_table"
  dictionary_query: "SELECT * FROM your_dictionary_table"

columns:
  species_number: species_no
  nbn_number: nbn_number
  verified: verified
  eastings: eastings
  northings: northings
  record_date: date_of_record
  modified_date: date_mdb_modified

reconciliation:
  hash_columns:
    - scientific_name
    - abundance
    - sex_stage
    - record_type
    - vitality
    - verified
    - eastings
    - northings
  chunk_size: 5000

generalisation:
  d0_floor_m: 100
  default_sensitive_resolution_m: 1000

aggregation:
  # Legacy pandas preview only; the approval artifact is production authority.
  # Safe-v1 has no additional sparse-cell suppression after safety gates (k=1).
  suppression_threshold: 1
  cell_size_m: 1000

species_resolutions: {}

verified_values:
  accepted:
    - "Accepted - correct"
    - "Accepted - considered correct"
    - "Accepted"
  legacy:
    - "BRERC"

flagged_record_types:
  - trapped at actinic light
  - trapped at light
  - trapped at mercury vapour light
  - night roost
  - tagged night roost
  - plant count
  - maternity roost
  - flower count
  - photographed
  - summer roost
  - hibernation
  - daylight site visit
  - day roost
  - rosette count
  # for bat roost and plant
  - field record
  - field record (bat roost sensitive record)
  - field record (plant sensitive record)
  - bat detector
  - box survey
  - hibernation roost
  - earth
  - droppings
  - handled
  - burrow
  - pre-parturition roost
  - netted
  - breeding
  - roost
  - emergence count
  - tagged day roost
  - grounded
  - possibly breeding
  - nest
  - holt
  - bedding
  - bat roost
  - lie-up
  - DNA or eDNA testing
  - AI or programme analysis
  - Beaver Lodge
  - Acoustic audio recording
  - Acoustic audio record
  - found dead
  - dam
  - gnawed timber
